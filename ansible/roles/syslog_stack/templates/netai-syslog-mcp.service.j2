[Unit]
Description=NetAI read-only network-device syslog intelligence MCP service
After=network-online.target{% if netai_clickhouse_enabled | bool %} clickhouse-server.service{% endif %}{% if netai_redis_enabled | bool %} redis-server.service{% endif %}

Wants=network-online.target{% if netai_clickhouse_enabled | bool %} clickhouse-server.service{% endif %}{% if netai_redis_enabled | bool %} redis-server.service{% endif %}

[Service]
Type=simple
User={{ netai_user }}
Group={{ netai_group }}
WorkingDirectory={{ netai_release_dir }}
EnvironmentFile={{ netai_release_dir }}/log_ingestor/.env
ExecStart={{ netai_syslog_mcp_binary_path }}
Restart=always
RestartSec=5
CPUQuota={{ netai_syslog_mcp_cpu_quota }}
MemoryHigh={{ netai_syslog_mcp_memory_high }}
MemoryMax={{ netai_syslog_mcp_memory_max }}
TasksMax={{ netai_syslog_mcp_tasks_max }}
StandardOutput=append:{{ netai_log_dir }}/syslog_mcp.log
StandardError=append:{{ netai_log_dir }}/syslog_mcp.err.log

[Install]
WantedBy=multi-user.target
