[Unit]
Description=NetAI network-device syslog ingestor
After=network-online.target{% if netai_clickhouse_enabled | bool %} clickhouse-server.service{% endif %}{% if netai_redis_enabled | bool %} redis-server.service{% endif %}

Wants=network-online.target{% if netai_clickhouse_enabled | bool %} clickhouse-server.service{% endif %}{% if netai_redis_enabled | bool %} redis-server.service{% endif %}

[Service]
Type=simple
User={{ netai_user }}
Group={{ netai_group }}
WorkingDirectory={{ netai_release_dir }}
EnvironmentFile={{ netai_release_dir }}/log_ingestor/.env
ExecStart={{ netai_log_ingestor_binary_path }}
Restart=always
RestartSec=5
CPUQuota={{ netai_log_ingestor_cpu_quota }}
MemoryHigh={{ netai_log_ingestor_memory_high }}
MemoryMax={{ netai_log_ingestor_memory_max }}
TasksMax={{ netai_log_ingestor_tasks_max }}
StandardOutput=append:{{ netai_log_dir }}/log_ingestor.log
StandardError=append:{{ netai_log_dir }}/log_ingestor.err.log

[Install]
WantedBy=multi-user.target
