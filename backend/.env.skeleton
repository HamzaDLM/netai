# Do not commit credentials.
PROJECT_NAME=NetAI
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:5173
SQLALCHEMY_URL=sqlite+aiosqlite:///./netai_local.db

GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
LLM_CONTEXT_WINDOW=100000
CHAT_CONTEXT_RECENT_MESSAGES=10
AGENT_RUN_TIMEOUT_SECONDS=300

TOOLS_USE_MOCK_DATA=true

ZABBIX_ENABLED=false
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
ZABBIX_TIMEOUT_SECONDS=12

SUZIEQ_ENABLED=false
SUZIEQ_API_URL=https://localhost:8000
SUZIEQ_API_TOKEN=
SUZIEQ_TIMEOUT_SECONDS=12
SUZIEQ_VERIFY_TLS=false

BITBUCKET_ENABLED=false
BITBUCKET_URL=
BITBUCKET_CLONE_DIR=
BITBUCKET_GIT_TIMEOUT_SECONDS=60

SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_API_VERSION=v2
SERVICENOW_ACCESS_TOKEN=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TIMEOUT_SECONDS=12

# Optional external source-of-truth connector.
INFRAHUB_MCP_URL=http://127.0.0.1:8001/mcp
INFRAHUB_MCP_TOKEN=
INFRAHUB_MCP_TIMEOUT_SECONDS=5

# Optional external SuzieQ MCP connector. When available, it takes precedence
# over the direct SuzieQ API tools for relevant requests.
SUZIEQ_MCP_URL=http://127.0.0.1:8002/mcp
SUZIEQ_MCP_TOKEN=
SUZIEQ_MCP_TIMEOUT_SECONDS=5

# Standalone read-only log intelligence service.
LOG_MCP_URL=http://127.0.0.1:8010/mcp
LOG_MCP_TOKEN=
LOG_MCP_TIMEOUT_SECONDS=8

# Token required by NetAI's exposed MCP servers.
MCP_CONSUMER_TOKEN=

# Generic OTLP/HTTP tracing.
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_SERVICE_NAME=netai
OTEL_TRACE_SAMPLE_RATE=1.0
HAYSTACK_CONTENT_TRACING_ENABLED=false

# Alternatively export OTLP traces directly to Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3002
LANGFUSE_SAMPLE_RATE=1.0
