# log_ingestor environment skeleton
# Copy to log_ingestor/.env for local runs if you need overrides.

RUST_LOG=info

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=syslogs
KAFKA_GROUP_ID=log-ingestor

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=netops
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_RETENTION_DAYS=30
CLICKHOUSE_BATCH_SIZE=1000
CLICKHOUSE_FLUSH_INTERVAL_MS=100
CLICKHOUSE_INSERT_QUEUE_CAPACITY=20000
CLICKHOUSE_INSERT_MAX_RETRIES=5
CLICKHOUSE_INSERT_RETRY_BACKOFF_MS=250
CLICKHOUSE_INSERT_TIMEOUT_SECS=10

# Maximum records concurrently processing or awaiting durable ClickHouse acknowledgement.
INGEST_MAX_IN_FLIGHT=256
KAFKA_LAG_POLL_INTERVAL_SECS=15

# Prometheus endpoint for the ingestion process only.
METRICS_BIND=0.0.0.0:9898

# Standalone network-device syslog MCP process (`cargo run --bin syslog_mcp`).
SYSLOG_MCP_BIND=0.0.0.0:8010
SYSLOG_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,syslog_mcp
SYSLOG_MCP_TOKEN=
SYSLOG_QUERY_DEFAULT_WINDOW_SECS=3600
SYSLOG_QUERY_MAX_WINDOW_SECS=604800
SYSLOG_QUERY_MAX_RESULTS=200
SYSLOG_QUERY_TIMEOUT_SECS=8

# Comma-separated and/or newline-separated substrings to drop before normalization.
IGNORED_SYSLOG_TEXTS=

REDIS_URL=
VENDOR_LOOKUP_URL=
VENDOR_REFRESH_SECS=900
VENDOR_CACHE_PREFIX=vendor_cache
